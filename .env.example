# Copy to .env.local for local work, and add the same names in Vercel:
# Project -> Settings -> Environment Variables.

# Contact form email (EmailJS). Public by design: they end up in the browser.
# (The old REACT_APP_EMAILJS_* names still work too, so existing Vercel values keep working.)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Telegram alert for new contact messages (api/contact.js). SECRET: server-side only,
# never prefix these with NEXT_PUBLIC_ (that would publish them). Create the bot with @BotFather; get your chat id
# by messaging the bot and opening https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
